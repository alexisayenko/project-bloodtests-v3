{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bloodtests",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-08-25",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{ "pattern": "blood.isayenko.net", "custom_domain": true },
		{ "pattern": "paneloom.com", "custom_domain": true }
	]
}

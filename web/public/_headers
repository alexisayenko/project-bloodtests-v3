/d/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, max-age=0, must-revalidate

# Vite content-hashes every filename under /assets/, so a cached copy is safe
# to keep indefinitely -- a rebuild always ships a new URL, never the same
# one with different bytes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The favicon and touch icon aren't content-hashed, but they never change
# without a filename edit -- if one is ever swapped, rename the file so
# browsers fetch the new one instead of serving a year-old cached copy.
/favicon.*
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

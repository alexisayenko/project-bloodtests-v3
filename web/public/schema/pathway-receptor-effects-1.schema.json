{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paneloom.com/schema/pathway-receptor-effects-1.schema.json",
  "title": "PathwayReceptorEffects",
  "description": "Receptor effects, schema 1: web/public/data/pathway-receptor-effects.json. What activating each receptor node on Hormonal Pathways does in adult men, every effect backed by at least one cited source and the source's own words. App-internal data with no outside authors, so the objects are CLOSED, as in analytes-1.schema.json.",
  "type": "object",
  "required": ["receptors", "sources"],
  "additionalProperties": false,
  "properties": {
    "receptors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/receptor" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "receptor": {
      "type": "object",
      "title": "Receptor",
      "required": ["id", "name", "ligands", "effects"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug", "description": "Required. The diagram node id the card sits under (`data-node`)." },
        "name": { "type": "string", "minLength": 1 },
        "ligands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Required. The hormones that activate it."
        },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "effect": {
      "type": "object",
      "title": "Effect",
      "required": ["id", "text", "citations"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "text": { "type": "string", "minLength": 1, "description": "Required. The effect in plain words, as the card's bullet shows it." },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" },
          "description": "Required. The sources backing it, in citation order; an effect with none is not allowed."
        }
      }
    },
    "citation": {
      "type": "object",
      "title": "Citation",
      "required": ["source", "quotes"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/slug", "description": "Required. An id into `sources`." },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Required. Short exact excerpts from the source supporting the effect; `…` marks an elision and `[…]` an inserted context note."
        }
      }
    },
    "source": {
      "type": "object",
      "title": "Source",
      "required": ["id", "organization", "title", "url", "retrieved"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "organization": { "type": "string", "minLength": 1, "description": "Required. Journal or publisher, with the authors in parentheses." },
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900 },
        "url": { "type": "string", "pattern": "^https://" },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
        "pmid": { "type": "string", "pattern": "^\\d{1,9}$" },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "description": "Required. ISO date the quoted text was retrieved from `url`."
        }
      }
    }
  }
}

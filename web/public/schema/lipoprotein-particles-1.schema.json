{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paneloom.com/schema/lipoprotein-particles-1.schema.json",
  "title": "LipoproteinParticles",
  "description": "Lipoprotein particle reference data, schema 1: web/public/data/lipoprotein-particles.json. Size, density, structural apolipoproteins and mass composition of each particle Lipid Transport draws, every figure recorded exactly as one cited source printed it; where two sources print different figures both are kept, and the range the page shows is derived from them. A share no source gives is left out, never estimated. App-internal data with no outside authors, so the objects are CLOSED, as in analytes-1.schema.json.",
  "type": "object",
  "required": ["particles", "sources"],
  "additionalProperties": false,
  "properties": {
    "particles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/particle" },
      "description": "Required. In transport order, which is the order the page draws them in."
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "particle": {
      "type": "object",
      "title": "Particle",
      "required": ["id", "name", "structuralApolipoproteins", "majorApoproteins", "diameterNm", "densityGPerMl", "composition"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "structuralApolipoproteins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Required. The holder apoprotein(s) the glyph docks inside the particle, in drawing order; each must appear among `majorApoproteins`."
        },
        "majorApoproteins": {
          "type": "object",
          "required": ["printed", "source"],
          "additionalProperties": false,
          "properties": {
            "printed": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "source": { "$ref": "#/$defs/slug" }
          }
        },
        "diameterNm": { "$ref": "#/$defs/interval", "description": "Required. Diameter in nanometres." },
        "densityGPerMl": { "$ref": "#/$defs/interval", "description": "Required. Hydrated density in g/mL." },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "description": "Required, possibly empty. Share of the particle's total mass, per component, as each source printed it.",
          "properties": {
            "triglyceride": { "$ref": "#/$defs/figures" },
            "cholesterol": { "$ref": "#/$defs/figures", "description": "Total cholesterol, free plus esterified." },
            "phospholipid": { "$ref": "#/$defs/figures" },
            "protein": { "$ref": "#/$defs/figures" }
          }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "interval": {
      "type": "object",
      "title": "Interval",
      "required": ["source"],
      "anyOf": [{ "required": ["min"] }, { "required": ["max"] }],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "exclusiveMax": { "type": "boolean", "description": "Optional. True when the source printed only an upper bound as \"<max\"." },
        "approximate": { "type": "boolean", "description": "Optional. True when the source printed the figure as \"~\"." },
        "source": { "$ref": "#/$defs/slug" }
      }
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/figure" }
    },
    "figure": {
      "type": "object",
      "title": "Figure",
      "required": ["value", "source"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 100, "description": "Required. Percent of total particle mass." },
        "approximate": { "type": "boolean" },
        "source": { "$ref": "#/$defs/slug" }
      }
    },
    "source": {
      "type": "object",
      "title": "Source",
      "required": ["id", "authors", "title", "publication", "url", "retrieved"],
      "oneOf": [{ "required": ["quote"] }, { "required": ["table"] }],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "authors": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "publication": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900 },
        "url": { "type": "string", "pattern": "^https://" },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "description": "Required. ISO date the figures were retrieved from `url`."
        },
        "quote": { "type": "string", "minLength": 1, "maxLength": 200, "description": "The source's own words carrying the figures, under 25 words." },
        "table": { "type": "string", "minLength": 1, "description": "The source table the figures are read from, by its own number and title." }
      }
    }
  }
}

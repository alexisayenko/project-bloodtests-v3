{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs"],
  "project": ["src/**", "worker/**", "scripts/**", "test/**"],
  "ignore": ["src/vendor/**", "src/data/envelopeTypes.ts"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off",
    "binaries": "off",
    "optionalPeerDependencies": "off"
  }
}
